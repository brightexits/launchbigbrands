---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
---

<BaseLayout 
  title="Blog - Launch Big Brands ™"
  description="Insights, strategies, and tips for scaling your ecommerce business. Learn from the experts at Launch Big Brands."
>
  <Header showYellowStrip={false} />

  <main style="background:#f8fafc;padding:60px 20px;min-height:70vh;">
    <style>
      .blog-page {
        max-width: 1100px;
        margin: 0 auto;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      }
      .blog-header {
        text-align: center;
        margin-bottom: 48px;
      }
      .blog-header h1 {
        font-size: clamp(32px, 5vw, 44px);
        font-weight: 900;
        margin: 0 0 12px;
        color: #0f172a;
      }
      .blog-header p {
        color: #475569;
        font-size: 18px;
        line-height: 1.6;
      }

      .blog-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 28px;
      }

      @media (min-width: 768px) {
        .blog-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1024px) {
        .blog-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .blog-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(2,6,23,.06);
        border: 1px solid #e5e7eb;
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none;
        display: block;
      }

      .blog-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(2,6,23,.12);
      }

      .blog-card-image {
        width: 100%;
        height: 200px;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        color: #fff;
      }

      .blog-card-content {
        padding: 24px;
      }

      .blog-card-date {
        font-size: 13px;
        color: #2563eb;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
      }

      .blog-card h2 {
        font-size: 22px;
        font-weight: 800;
        margin: 0 0 12px;
        color: #0f172a;
        line-height: 1.3;
      }

      .blog-card p {
        color: #475569;
        line-height: 1.6;
        margin: 0;
        font-size: 15px;
      }

      .read-more {
        display: inline-block;
        margin-top: 16px;
        color: #2563eb;
        font-weight: 700;
        font-size: 15px;
      }
    </style>

    <div class="blog-page">
      <div class="blog-header">
        <h1>Ecommerce Insights & Strategies</h1>
        <p>Expert tips, proven tactics, and industry insights to help you scale your Shopify store.</p>
      </div>

      <div class="blog-grid">
        <a href="/blog/launching-your-ecommerce-brand-in-2026" class="blog-card">
          <div class="blog-card-image" aria-hidden="true">🚀</div>
          <div class="blog-card-content">
            <div class="blog-card-date">December 18, 2025</div>
            <h2>Launching Your Ecommerce Brand in 2026: A Strategic Blueprint</h2>
            <p>Discover the essential steps to successfully launch and scale your ecommerce brand in 2026 with proven strategies from Launch Big Brands.</p>
            <span class="read-more">Read Article →</span>
          </div>
        </a>

        <!-- Placeholder for future articles -->
        <div style="background:#fff;border-radius:16px;padding:40px;text-align:center;border:2px dashed #e5e7eb;">
          <p style="color:#94a3b8;font-size:16px;margin:0;">More articles coming soon...</p>
        </div>

        <div style="background:#fff;border-radius:16px;padding:40px;text-align:center;border:2px dashed #e5e7eb;">
          <p style="color:#94a3b8;font-size:16px;margin:0;">More articles coming soon...</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
