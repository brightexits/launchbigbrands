---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { organizationSchema } from '../lib/schema.ts';
---

<BaseLayout 
  title="Contact Us - Launch Big Brands ™"
  description="Get in touch with Launch Big Brands. We're here to help scale your Shopify store with expert ecommerce growth strategies."
  structuredData={organizationSchema}
>
  <Header showYellowStrip={false} />

  <main style="background:#f8fafc;padding:60px 20px;">
    <style>
      .contact-page {
        max-width: 1000px;
        margin: 0 auto;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      }
      .contact-header {
        text-align: center;
        margin-bottom: 48px;
      }
      .contact-header h1 {
        font-size: clamp(32px, 5vw, 44px);
        font-weight: 900;
        margin: 0 0 12px;
        color: #0f172a;
      }
      .contact-header p {
        color: #475569;
        font-size: 18px;
        line-height: 1.6;
        max-width: 600px;
        margin: 0 auto;
      }

      .contact-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
      }
      
      @media (min-width: 768px) {
        .contact-container {
          grid-template-columns: 1fr 1fr;
        }
      }

      .contact-form {
        background: #fff;
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 8px 32px rgba(2,6,23,.08);
        border: 1px solid #e5e7eb;
      }
      
      .contact-form h2 {
        font-size: 24px;
        font-weight: 800;
        margin: 0 0 24px;
        color: #0f172a;
      }

      .form-group {
        margin-bottom: 20px;
      }

      .form-group label {
        display: block;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 8px;
        font-size: 15px;
      }

      .form-group input,
      .form-group textarea {
        width: 100%;
        padding: 12px 16px;
        font-size: 16px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-family: inherit;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .form-group input:focus,
      .form-group textarea:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
      }

      .form-group textarea {
        min-height: 140px;
        resize: vertical;
      }

      .submit-button {
        width: 100%;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        color: #fff;
        font-weight: 800;
        font-size: 18px;
        padding: 16px 32px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 6px 20px rgba(37,99,235,.25);
      }

      .submit-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(37,99,235,.35);
      }

      .submit-button:active {
        transform: translateY(0);
      }

      .contact-info {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .info-card {
        background: #fff;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 4px 20px rgba(2,6,23,.06);
        border: 1px solid #e5e7eb;
      }

      .info-card h3 {
        font-size: 20px;
        font-weight: 800;
        margin: 0 0 16px;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .info-card .icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        display: grid;
        place-items: center;
        font-size: 20px;
        flex-shrink: 0;
      }

      .info-card p {
        color: #475569;
        line-height: 1.7;
        margin: 0;
        font-size: 16px;
      }

      .info-card a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
      }

      .info-card a:hover {
        text-decoration: underline;
      }

      .cta-card {
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        border-radius: 18px;
        padding: 28px;
        color: #fff;
        text-align: center;
      }

      .cta-card h3 {
        font-size: 22px;
        font-weight: 900;
        margin: 0 0 12px;
      }

      .cta-card p {
        margin: 0 0 20px;
        opacity: 0.95;
        line-height: 1.6;
      }

      .cta-card a {
        display: inline-block;
        background: #fff;
        color: #2563eb;
        font-weight: 800;
        padding: 14px 28px;
        border-radius: 10px;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .cta-card a:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,.15);
      }
    </style>

    <div class="contact-page">
      <div class="contact-header">
        <h1>Get in Touch with Launch Big Brands</h1>
        <p>
          Have questions about scaling your Shopify store? Ready to grow? Drop us a message and we'll get back to you within 24 hours.
        </p>
      </div>

      <div class="contact-container">
        <div class="contact-form">
          <h2>Send Us a Message</h2>
          <form id="contact-form" action="#" method="POST">
            <div class="form-group">
              <label for="name">Your Name <span style="color:#ef4444">*</span></label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                placeholder="John Doe"
              >
            </div>

            <div class="form-group">
              <label for="email">Email Address <span style="color:#ef4444">*</span></label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="john@example.com"
              >
            </div>

            <div class="form-group">
              <label for="message">Your Message <span style="color:#ef4444">*</span></label>
              <textarea 
                id="message" 
                name="message" 
                required 
                placeholder="Tell us about your Shopify store and how we can help..."
              ></textarea>
            </div>

            <button type="submit" class="submit-button">Send Message</button>
          </form>

          <p style="margin-top:16px;font-size:14px;color:#64748b;text-align:center;">
            By submitting this form, you agree to our <a href="/privacy-policy" style="color:#2563eb;text-decoration:none;font-weight:600;">Privacy Policy</a>.
          </p>
        </div>

        <div class="contact-info">
          <div class="info-card">
            <h3>
              <span class="icon">📧</span>
              Email Us
            </h3>
            <p>
              Prefer email? Reach out directly at:<br>
              <a href="mailto:hello@launchbigbrands.com">hello@launchbigbrands.com</a>
            </p>
          </div>

          <div class="info-card">
            <h3>
              <span class="icon">⏰</span>
              Response Time
            </h3>
            <p>
              We typically respond within 24 hours during business days (Monday - Friday, 9 AM - 6 PM EST).
            </p>
          </div>

          <div class="cta-card">
            <h3>Ready to Scale?</h3>
            <p>
              Skip the form and book a free strategy call. We'll discuss your store, goals, and how we can help you grow.
            </p>
            <a href="/#book">Book Your Free Call</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Form submission handler (placeholder - connect to your backend later)
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form') as HTMLFormElement;
      
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const formData = new FormData(form);
          const data = {
            name: formData.get('name'),
            email: formData.get('email'),
            message: formData.get('message')
          };

          // TODO: Replace with actual backend endpoint
          console.log('Form submitted:', data);
          
          // Show success message (placeholder)
          alert('Thank you for contacting Launch Big Brands! We\'ll get back to you within 24 hours.');
          form.reset();

          // In production, send data to your backend:
          // const response = await fetch('/api/contact', {
          //   method: 'POST',
          //   headers: { 'Content-Type': 'application/json' },
          //   body: JSON.stringify(data)
          // });
        });
      }
    });
  </script>
</BaseLayout>
