---
const { showYellowStrip = true } = Astro.props;
---

{showYellowStrip && (
  <div class="utility-bar color-scheme-1 gradient">
    <div style="background:#facc15;color:#0f172a;text-align:center;
            padding:8px 14px;
            font-weight:800;font-size:14px;letter-spacing:.02em;
            display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:12px;">
      🔒 Limited spots available
      <a href="/#book" style="position:relative;overflow:hidden;
                padding:6px 16px;
                border-radius:999px;
                background:linear-gradient(135deg,#2563eb,#06b6d4);
                color:#fff;
                font-weight:800;
                font-size:13px;
                text-decoration:none;
                box-shadow:0 3px 10px rgba(37,99,235,.3);
                transition:transform .2s ease;">
        Get Started
        <span style="position:absolute;top:0;left:-60%;width:50%;height:100%;
                     background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.55),rgba(255,255,255,0));
                     transform:skewX(-20deg);
                     animation:shine 2.5s infinite;"></span>
      </a>
    </div>
  </div>
)}

<header style={showYellowStrip ? "text-align: center; padding: 20px 0;" : "text-align: center; padding: 20px 0; border-bottom: 1px solid #e5e7eb;"}>
  <h1 style="margin: 0;">
    <a href="/" style="text-decoration: none; color: inherit;">
      <img src="/assets/images/Untitled_design_16.png" 
           alt="Launch Big Brands ™" 
           width="200"
           height="54"
           style="height: 54px; width: auto;"
           srcset="/assets/images/Untitled_design_16_1.png 160w, 
                   /assets/images/Untitled_design_16_2.png 240w, 
                   /assets/images/Untitled_design_16_3.png 320w">
    </a>
  </h1>
</header>

<style>
  @keyframes shine {
    0% { left:-60%; }
    60% { left:120%; }
    100% { left:120%; }
  }
</style>
